VITE_BASE=/
VITE_APP_TITLE=Grove Console

# 接口地址。留空即同域：由网关把 /console/v1 反向代理到 Console 服务。
# 跨域部署时填 Console 地址；构建后也可直接改 dist/_app.config.js，不必重新构建。
VITE_GLOB_API_URL=

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
