APP_NAME=golang-web
APP_ENV=development
# Defaults to true outside production and false in production when omitted.
# Supported values: true/false/1/0/yes/no.
APP_DEBUG=
APP_PORT=8080
CONSOLE_PORT=8081

SERVER_SHUTDOWN_TIMEOUT=30
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30
SERVER_MAX_HEADER_BYTES=1048576

LOG_LEVEL=info
LOG_PATH=./logs
LOG_CONSOLE=true
LOG_SERVICE=golang-web

DB_ENABLED=false
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=golang_web
DB_SSLMODE=disable
DB_MAX_CONNECTIONS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=3600

REDIS_ENABLED=false
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=change-me
JWT_ISSUER=golang-web
JWT_ACCESS_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_HOURS=168

WORKER_ENABLED=false
JOB_CONCURRENCY=10
JOB_QUEUE_DEFAULT=5
JOB_QUEUE_CRITICAL=3
JOB_QUEUE_LOW=1

CASBIN_API_ENABLED=false
CASBIN_API_DATABASE=default
CASBIN_API_MODE=rbac
CASBIN_API_TABLE=casbin_rules
CASBIN_CONSOLE_ENABLED=false
CASBIN_CONSOLE_DATABASE=default
CASBIN_CONSOLE_MODE=rbac
CASBIN_CONSOLE_TABLE=console_casbin_rules

STORAGE_DEFAULT=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_LOCAL_BASE_URL=/storage
STORAGE_LOCAL_PREFIX=console
STORAGE_S3_DRIVER=s3
STORAGE_S3_ENDPOINT=s3.ap-southeast-1.amazonaws.com
STORAGE_S3_REGION=ap-southeast-1
STORAGE_S3_BUCKET=demo-bucket
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_SECURE=true
STORAGE_S3_BASE_URL=
STORAGE_S3_PREFIX=console
STORAGE_STS_ENABLED=false
STORAGE_STS_ENDPOINT=
STORAGE_STS_REGION=ap-southeast-1
STORAGE_STS_ROLE_ARN=
STORAGE_STS_ROLE_SESSION_NAME=golang-web-console
STORAGE_STS_DURATION=3600
STORAGE_STS_ALLOW_PREFIX=console/${user_id}
STORAGE_STS_ALLOW_ACTION_1=s3:PutObject
STORAGE_STS_ALLOW_ACTION_2=s3:GetObject
STORAGE_STS_ALLOW_ACTION_3=s3:AbortMultipartUpload
STORAGE_STS_ALLOW_ACTION_4=s3:ListBucketMultipartUploads
STORAGE_STS_ALLOW_ACTION_5=s3:ListMultipartUploadParts

DOCS_ENABLED=true
DOCS_TITLE=Golang Web API
DOCS_DESCRIPTION=API framework scaffold for interface-driven services
DOCS_VERSION=1.0.0
DOCS_BASE_PATH=/api/v1
DOCS_SCHEME_1=http

CORS_ENABLED=true
CORS_ALLOWED_ORIGIN_1=*
CORS_ALLOWED_METHOD_1=GET
CORS_ALLOWED_METHOD_2=POST
CORS_ALLOWED_METHOD_3=PUT
CORS_ALLOWED_METHOD_4=PATCH
CORS_ALLOWED_METHOD_5=DELETE
CORS_ALLOWED_METHOD_6=OPTIONS
CORS_ALLOWED_HEADER_1=Authorization
CORS_ALLOWED_HEADER_2=Content-Type
CORS_ALLOWED_HEADER_3=X-Request-Id
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=600

API_PREFIX=/api/v1
API_DEFAULT_PER_PAGE=20
API_MAX_PER_PAGE=100
